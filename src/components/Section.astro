---
interface Props {
    id?: string;
    class?: string;
    labelledby?: string;
}
const { id, class: className = '', labelledby } = Astro.props;
---

<section
    id={id}
    aria-labelledby={labelledby}
    class:list={['mx-auto w-full max-w-[70rem] px-4 py-10 md:px-6 md:py-14', className]}
>
    <slot />
</section>
