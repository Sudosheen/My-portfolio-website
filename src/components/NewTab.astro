---
/** Cue for a link that opens in a new tab: a small arrow (decorative) and a note for screen readers. */
import { ArrowUpRight } from '@untitledui/icons';
import { langFrom, useUi } from '../i18n/utils';

const t = useUi(langFrom(Astro.currentLocale)).a11y;
---

<ArrowUpRight size={14} className="ml-0.5 inline-block align-text-bottom" aria-hidden="true" /><span class="sr-only"> ({t.newTab})</span>
