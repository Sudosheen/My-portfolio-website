---
import { getCollection } from 'astro:content';
import { langFrom, monthYear, useUi } from '../../i18n/utils';
import Section from '../Section.astro';
import Module from '../instrument/Module.astro';

const lang = langFrom(Astro.currentLocale);
const t = useUi(lang).log;
const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

function range(start: string | null, end: string | null, current: boolean): string[] {
    const s = monthYear(start);
    const e = monthYear(end);
    if (current) return s ? [s, `→ ${t.now}`] : [t.now];
    if (s && e && s !== e) return [s, `→ ${e}`];
    return [s ?? e ?? ''];
}
---

<Section id="log" labelledby="log-title">
    <h2 id="log-title" class="display text-4xl md:text-5xl">{t.title}</h2>
    <p class="muted mt-3">{t.intro}</p>

    <ol class="mt-8 grid gap-4">
        {
            entries.map((entry, i) => {
                const d = entry.data;
                const text = d[lang];
                const dates = range(d.start, d.end, d.current);
                return (
                    <li>
                        <Module
                            code={`MOD.03.${String(i + 1).padStart(2, '0')} / LOG`}
                            title={text.role}
                            status={d.current ? t.current : undefined}
                        >
                            <div class="grid gap-4 md:grid-cols-[8rem_1fr]">
                                <p class="mono faint">
                                    {dates.map((line) => (
                                        <>
                                            {line}
                                            <br />
                                        </>
                                    ))}
                                </p>
                                <div>
                                    <p class="muted">
                                        {d.org}
                                        {d.unit ? ` · ${d.unit}` : ''} · {d.place}
                                        {text.contract ? ` · ${text.contract}` : ''}
                                    </p>
                                    <ul class="mt-3 list-disc space-y-1.5 pl-5 marker:text-ink-faint">
                                        {text.points.map((p) => (
                                            <li>{p}</li>
                                        ))}
                                    </ul>
                                    <ul class="mt-4 flex flex-wrap gap-1.5" aria-hidden="true">
                                        {d.tags.map((tag) => (
                                            <li class="tag">{tag}</li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </Module>
                    </li>
                );
            })
        }
    </ol>
</Section>
