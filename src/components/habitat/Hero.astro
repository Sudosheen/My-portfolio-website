---
import { ArrowUpRight } from '@untitledui/icons';
import { profile } from '../../data/profile';
import { href, langFrom, useUi } from '../../i18n/utils';
import BuildModule from '../instrument/BuildModule.astro';
import CareerModule from '../instrument/CareerModule.astro';
import Clock from '../instrument/Clock.astro';
import LocationModule from '../instrument/LocationModule.astro';

const lang = langFrom(Astro.currentLocale);
const t = useUi(lang).hero;
const { lat, lon, timeZone } = profile.location;
---

<section
    id="intro"
    aria-labelledby="hero-name"
    class="mx-auto w-full max-w-[70rem] px-4 pb-8 pt-10 md:px-6 md:pb-12 md:pt-10"
>
    <div class="hero-grid">
        <div class="hero-text">
            <h1 id="hero-name" class="hero-name">Osheen<br />Turner</h1>
            <p class="mt-6 text-xl font-medium">{t.role}</p>
            <p class="muted mt-1">{t.org}</p>
            <p class="muted mt-4 max-w-md">{t.line}</p>
            <div class="mt-8 flex flex-wrap gap-2 sm:gap-3">
                <a class="pill-btn pill-btn--primary" href="#contact">{t.contact}</a>
                <a class="pill-btn" href={href(lang, 'cv/')}>{t.cv}</a>
                <a class="pill-btn" href={href(lang, 'card/')}>
                    {t.card}
                    <ArrowUpRight size={18} aria-hidden="true" />
                </a>
            </div>
        </div>

        <!-- Live control panel: instrument modules that power on one by one. Values come from tick.ts. -->
        <div
            class="hero-panel"
            data-live-config
            data-lat={lat}
            data-lon={lon}
            data-tz={timeZone}
            data-since={profile.digitalSince}
        >
            <Clock />
            <LocationModule />
            <BuildModule />
            <CareerModule />
        </div>
    </div>
</section>
