---
import { profile } from '../../data/profile';
import { dotMatrix } from '../../lib/dotmatrix';
import { langFrom, useUi } from '../../i18n/utils';

const t = useUi(langFrom(Astro.currentLocale)).hero;
const idle = dotMatrix('--:--');
const { lat, lon, timeZone } = profile.location;
---

<div
    class="module tk has-led"
    role="group"
    aria-label={t.clock}
    data-clock
    data-lat={lat}
    data-lon={lon}
    data-tz={timeZone}
    data-label-sun={t.sun}
    data-label-daylight={t.daylight}
    data-label-night={t.night}
>
    <div class="module-head">
        <span class="mono" aria-hidden="true">MOD.01 / CLOCK</span>
        <i class="led" aria-hidden="true"></i>
    </div>
    <div class="px-4 pb-4 pt-3">
        <svg
            class="dm max-w-44"
            data-dm
            viewBox={idle.viewBox}
            aria-hidden="true"
            focusable="false"
            set:html={idle.inner}
        />
        <p class="mono mt-3">
            <span class="faint">{t.clock}</span><br />
            <span data-clock-text>--:--</span>
        </p>
        <div class="daytrack" aria-hidden="true"><i data-sun-marker style="left: 0%"></i></div>
        <p class="mono faint" data-sun-text>{t.sun}</p>
    </div>
</div>
