---
import { profile } from '../data/profile';
import { buildInfo } from '../lib/build-info';
import { href, langFrom, useUi } from '../i18n/utils';

const lang = langFrom(Astro.currentLocale);
const t = useUi(lang);
const year = buildInfo.date.slice(0, 4);
const links = [
    { label: t.footer.card, href: href(lang, 'card/') },
    { label: t.footer.colophon, href: href(lang, 'colophon/') },
    { label: t.footer.legal, href: href(lang, 'legal/') },
    { label: t.footer.source, href: profile.repo },
];
---

<footer class="no-print mx-auto mt-6 w-full max-w-[70rem] px-4 pb-10 md:px-6">
    <div class="module tk flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-3 py-2">
        <p class="mono faint flex flex-wrap gap-x-4 gap-y-1">
            <span>{t.footer.build} {buildInfo.sha}</span>
            <span>{t.footer.deployed} {buildInfo.date}</span>
            <span>{t.footer.thirdParty} 0</span>
        </p>
        <ul class="mono flex flex-wrap gap-x-4 gap-y-1">
            {
                links.map((l) => (
                    <li>
                        <a
                            class="muted inline-flex min-h-6 items-center no-underline hover:text-ink hover:underline"
                            href={l.href}
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
    <p class="muted mt-4 text-sm">© {year} {profile.name} · {t.footer.rights}</p>
</footer>
