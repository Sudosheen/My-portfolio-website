---
import audit from '../../data/audit.json';
import { profile } from '../../data/profile';
import { href, langFrom, useUi } from '../../i18n/utils';
import Section from '../Section.astro';
import Module from '../instrument/Module.astro';

const lang = langFrom(Astro.currentLocale);
const ui = useUi(lang);
const t = ui.colophon;

interface HomeAudit {
    totalKb: number;
    htmlKb: number;
    cssKb: number;
    jsKb: number;
    fontsKb: number;
    thirdParty: number;
}
const measured = audit.home as HomeAudit | null;
const kb = (n: number) => `${new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(n)} KB`;
const rows = measured
    ? [
          [t.measured.total, kb(measured.totalKb)],
          [t.measured.html, kb(measured.htmlKb)],
          [t.measured.css, kb(measured.cssKb)],
          [t.measured.js, kb(measured.jsKb)],
          [t.measured.fonts, kb(measured.fontsKb)],
          [t.measured.thirdParty, String(measured.thirdParty)],
      ]
    : [];
---

<Section class="pt-8 md:pt-12">
    <p class="mono faint"><a class="no-underline hover:underline" href={href(lang)}>← {ui.card.back}</a></p>
    <h1 class="page-title mt-4">{t.title}</h1>
    <p class="muted mt-4 max-w-2xl text-lg">{t.intro}</p>

    <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-4">
        <Module id="stack" code="MOD.09 / STACK" title={t.stackTitle}>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <caption class="sr-only">{t.stackTitle}</caption>
                    <thead>
                        <tr class="border-b border-hair">
                            <th scope="col" class="mono py-2 pr-4 font-normal text-ink-faint">{t.stackHead.layer}</th>
                            <th scope="col" class="mono py-2 pr-4 font-normal text-ink-faint">{t.stackHead.what}</th>
                            <th scope="col" class="mono py-2 font-normal text-ink-faint">{t.stackHead.license}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            t.stack.map((row) => (
                                <tr class="border-b border-hair align-top last:border-0">
                                    <th scope="row" class="py-3 pr-4 font-medium">{row.layer}</th>
                                    <td class="py-3 pr-4">{row.what}</td>
                                    <td class="mono py-3 whitespace-nowrap">{row.license}</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </Module>

        <Module id="measured" code="MOD.10 / AUDIT" title={t.measuredTitle} status={audit.audited ?? undefined}>
            <p class="muted max-w-2xl text-sm">{t.measuredNote}</p>
            {
                measured ? (
                    <dl class="spec mt-4">
                        <dt>{t.measured.audited}</dt>
                        <dd>{audit.audited}</dd>
                        {rows.map(([label, value]) => (
                            <>
                                <dt>{label}</dt>
                                <dd>{value}</dd>
                            </>
                        ))}
                    </dl>
                ) : (
                    <p class="mono faint mt-4">{t.measuredEmpty}</p>
                )
            }
            <p class="mt-5 max-w-2xl text-sm">{t.enforcement}</p>
        </Module>

        <Module id="a11y" code="MOD.11 / A11Y" title={t.a11yTitle}>
            <p class="max-w-2xl">{t.a11y}</p>
            <p class="mt-3"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        </Module>

        <Module id="source" code="MOD.12 / SRC" title={t.sourceTitle}>
            <p>
                {t.source}
                <a href={profile.repo} class="break-all">{profile.repo}</a>
            </p>
        </Module>
    </div>
</Section>
