---
import type { CollectionEntry } from 'astro:content';
import { href, langFrom, useUi } from '../../i18n/utils';
import { specRows } from '../../lib/project';
import Section from '../Section.astro';
import Module from '../instrument/Module.astro';

interface Props {
    entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const lang = langFrom(Astro.currentLocale);
const t = useUi(lang).projects;
const text = entry.data[lang];
const rows = specRows(entry, lang, t, true);
---

<Section class="pt-8 md:pt-12">
    <p class="mono faint">
        <a class="no-underline hover:underline" href={`${href(lang)}#projects`}>← {t.back}</a>
    </p>
    <h1 class="page-title mt-4 max-w-3xl">{text.title}</h1>
    <p class="muted mt-4 max-w-2xl text-lg">{text.summary}</p>

    <div class="mt-10 grid items-start gap-8 md:grid-cols-[1fr_20rem]">
        <article class="grid max-w-2xl gap-8">
            {
                text.sections.map((s) => (
                    <section>
                        <h2 class="display text-3xl">{s.heading}</h2>
                        <div class="mt-3 grid gap-3">
                            {s.body.map((p) => (
                                <p>{p}</p>
                            ))}
                        </div>
                    </section>
                ))
            }
        </article>

        <Module id="case-spec" code="MOD.04 / SPEC" title={t.spec} class="md:sticky md:top-24">
            <dl class="spec spec--stack">
                {
                    rows.map((r) => (
                        <>
                            <dt>{r.label}</dt>
                            <dd data-empty={r.value ? undefined : ''} class="mb-2">
                                {r.value ?? t.unknown}
                            </dd>
                        </>
                    ))
                }
            </dl>
        </Module>
    </div>
</Section>
